# Copy to .env and fill in as you obtain keys. Never commit .env.
# Digest email via Resend (Phase 1). Create a key at https://resend.com/api-keys
RESEND_API_KEY=
DIGEST_FROM=Job Bot <digest@your-verified-domain.example>
DIGEST_TO=you@example.com
# Phase 2 aggregator keys
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
JOOBLE_API_KEY=
MUSE_API_KEY=
